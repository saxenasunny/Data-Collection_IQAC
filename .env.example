# Supabase PostgreSQL Connection Strings
# 1. Transaction Pooler (Port 6543) - Used by Next.js app on Vercel
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Database Connection (Port 5432) - Used by Prisma CLI for migrations / db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Admin Authentication & Initial Credentials
ADMIN_SECRET="iqac_super_secure_admin_jwt_secret_change_in_production"
ADMIN_DEFAULT_EMAIL="admin@iqac.edu"
ADMIN_DEFAULT_PASSWORD="adminpassword123"
ADMIN_DEFAULT_NAME="IQAC Administrator"
